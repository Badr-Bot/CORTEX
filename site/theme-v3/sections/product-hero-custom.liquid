{
  "name": "Fiche produit Elarie",
  "settings": [
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "bg_color", "label": "Fond", "default": "#F8F5EC" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#50382A" },
    { "type": "header", "content": "En-tête" },
    { "type": "text", "id": "badge1_text", "label": "Badge 1", "default": "Best-seller" },
    { "type": "text", "id": "badge2_text", "label": "Badge 2", "default": "Anti-cellulite" },
    { "type": "text", "id": "tagline_text", "label": "Accroche", "default": "Technologie drainage 3D — Maison Elarie Paris" },
    { "type": "text", "id": "rating_text", "label": "Ligne d'avis", "default": "4,8 · 2 341 avis vérifiés" },
    { "type": "text", "id": "bundle_label", "label": "Titre du bloc lots", "default": "Choisissez votre lot" },
    {
      "type": "paragraph",
      "content": "Remises des lots, en CENTIMES. Elles doivent correspondre exactement aux remises automatiques de la boutique (Réductions), sinon le prix affiché ici ne sera pas celui facturé au panier. 999 = 9,99 €."
    },
    { "type": "number", "id": "bundle2_cut", "label": "Remise lot de 2 (centimes)", "default": 999 },
    { "type": "number", "id": "bundle3_cut", "label": "Remise lot de 3 (centimes)", "default": 1998 },
    { "type": "text", "id": "bundle2_tag", "label": "Étiquette du lot de 2", "default": "Le plus choisi" },
    { "type": "text", "id": "bundle3_tag", "label": "Étiquette du lot de 3", "default": "Meilleure valeur" },
    { "type": "text", "id": "urgence_text", "label": "Bandeau d'urgence", "default": "L'offre de la rentrée se termine ce soir" },
    { "type": "range", "id": "compteur_minutes", "label": "Compte à rebours", "min": 0, "max": 120, "step": 5, "unit": "min", "default": 30, "info": "0 pour ne pas l'afficher. Le minuteur repart à chaque nouvelle visite." },
    { "type": "header", "content": "Bénéfices" },
    { "type": "image_picker", "id": "benefit1_icon", "label": "Icône 1" },
    { "type": "text", "id": "benefit1_text", "label": "Bénéfice 1", "default": "Atténue visiblement la cellulite" },
    { "type": "image_picker", "id": "benefit2_icon", "label": "Icône 2" },
    { "type": "text", "id": "benefit2_text", "label": "Bénéfice 2", "default": "Galbe et sculpte sans comprimer" },
    { "type": "image_picker", "id": "benefit3_icon", "label": "Icône 3" },
    { "type": "text", "id": "benefit3_text", "label": "Bénéfice 3", "default": "Opacité garantie, même accroupie" },
    { "type": "image_picker", "id": "benefit4_icon", "label": "Icône 4" },
    { "type": "text", "id": "benefit4_text", "label": "Bénéfice 4", "default": "Taille haute qui ne roule jamais" },
    { "type": "header", "content": "Avis mis en avant" },
    { "type": "image_picker", "id": "review_avatar", "label": "Photo cliente" },
    { "type": "text", "id": "review_name", "label": "Prénom", "default": "Camille D." },
    { "type": "textarea", "id": "review_text", "label": "Extrait d'avis", "default": "Après trois semaines, ma peau est visiblement plus lisse et plus ferme." },
    { "type": "header", "content": "Pastilles de couleur" },
    {
      "type": "select",
      "id": "swatch_style",
      "label": "Apparence des pastilles",
      "options": [
        { "value": "uni", "label": "Aplat de couleur" },
        { "value": "photo", "label": "Photo du produit" }
      ],
      "default": "uni",
      "info": "« Photo du produit » n'affiche la photo que sur les couleurs auxquelles vous en avez associé une."
    },
    {
      "type": "paragraph",
      "content": "Ajoutez un bloc Couleur par coloris. Le nom doit être écrit exactement comme la valeur de l'option du produit (Noir, Abricot…). Sans bloc, la couleur est devinée d'après son nom."
    }
  ],
  "blocks": [
    {
      "type": "couleur",
      "name": "Couleur",
      "settings": [
        { "type": "text", "id": "name", "label": "Nom du coloris", "info": "Doit correspondre à l'option du produit, ex : Noir" },
        { "type": "color", "id": "swatch", "label": "Couleur de la pastille", "default": "#141414" },
        { "type": "image_picker", "id": "image", "label": "Photo affichée au clic" }
      ]
    }
  ]
}
{% endschema %}
