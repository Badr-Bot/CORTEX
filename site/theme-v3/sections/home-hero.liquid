{{ 'section-home-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .home-hero {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.height_mobile }}px;
    display: flex;
    align-items: {{ section.settings.vertical_position }};
    justify-content: center;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .home-hero {
      min-height: {{ section.settings.height_desktop }}px;
    }
  }

  #shopify-section-{{ section.id }} .home-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .home-hero__media img,
  #shopify-section-{{ section.id }} .home-hero__media picture {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .home-hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .home-hero__content {
    position: relative;
    z-index: 2;
    max-width: 60rem;
    padding: 3rem 2rem;
    text-align: {{ section.settings.text_align }};
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .home-hero__heading {
    font-size: 3.2rem;
    line-height: 1.1;
    margin: 0 0 1.5rem;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .home-hero__heading {
      font-size: {{ section.settings.heading_size }}rem;
    }
  }

  #shopify-section-{{ section.id }} .home-hero__subheading {
    font-size: 1.6rem;
    line-height: 1.5;
    margin: 0 0 2.5rem;
  }

  #shopify-section-{{ section.id }} .home-hero__buttons {
    display: flex;
    gap: 1.5rem;
    justify-content: {% if section.settings.text_align == 'center' %}center{% elsif section.settings.text_align == 'right' %}flex-end{% else %}flex-start{% endif %};
    flex-wrap: wrap;
  }
{%- endstyle -%}

<div class="home-hero color-{{ section.settings.color_scheme }}">
  <div class="home-hero__media">
    {%- if section.settings.image_mobile != blank or section.settings.image_desktop != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 1500 }}">
        {%- endif -%}
        {%- if section.settings.image_desktop != blank -%}
          <img
            src="{{ section.settings.image_desktop | image_url: width: 2000 }}"
            srcset="
              {{ section.settings.image_desktop | image_url: width: 750 }} 750w,
              {{ section.settings.image_desktop | image_url: width: 1500 }} 1500w,
              {{ section.settings.image_desktop | image_url: width: 2000 }} 2000w,
              {{ section.settings.image_desktop | image_url: width: 3000 }} 3000w
            "
            sizes="100vw"
            alt="{{ section.settings.image_desktop.alt | default: section.settings.heading | escape }}"
            width="{{ section.settings.image_desktop.width }}"
            height="{{ section.settings.image_desktop.height }}"
            loading="eager"
            fetchpriority="high"
          >
        {%- else -%}
          <img
            src="{{ section.settings.image_mobile | image_url: width: 1500 }}"
            alt="{{ section.settings.image_mobile.alt | default: section.settings.heading | escape }}"
            width="{{ section.settings.image_mobile.width }}"
            height="{{ section.settings.image_mobile.height }}"
            loading="eager"
            fetchpriority="high"
          >
        {%- endif -%}
      </picture>
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'home-hero__placeholder' }}
    {%- endif -%}
  </div>

  {%- if section.settings.overlay_opacity > 0 -%}
    <div class="home-hero__overlay"></div>
  {%- endif -%}

  <div class="home-hero__content">
    {%- if section.settings.heading != blank -%}
      <h1 class="home-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <div class="home-hero__subheading">{{ section.settings.subheading }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="home-hero__buttons">
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="button {% if section.settings.button_style == 'outline' %}button--secondary{% else %}button--primary{% endif %}"
        >
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero Home",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image desktop"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image mobile (optionnelle)",
      "info": "Si vide, l'image desktop sera utilisée sur mobile."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Opacité du calque sombre",
      "default": 30
    },
    {
      "type": "header",
      "content": "Dimensions"
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Hauteur mobile",
      "default": 500
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 400,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Hauteur desktop",
      "default": 650
    },
    {
      "type": "select",
      "id": "vertical_position",
      "label": "Position verticale du contenu",
      "options": [
        { "value": "flex-start", "label": "Haut" },
        { "value": "center", "label": "Centre" },
        { "value": "flex-end", "label": "Bas" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Texte"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Élégance intemporelle"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 3,
      "max": 8,
      "step": 0.5,
      "unit": "rem",
      "label": "Taille du titre (desktop)",
      "default": 5
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "<p>Découvrez la nouvelle collection Elarie Paris.</p>"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alignement du texte",
      "options": [
        { "value": "left", "label": "Gauche" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Droite" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Bouton"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Découvrir"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style du bouton",
      "options": [
        { "value": "solid", "label": "Plein" },
        { "value": "outline", "label": "Contour" }
      ],
      "default": "solid"
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Hero Home"
    }
  ]
}
{% endschema %}
