{% comment %}
  Section : Guide des tailles Elarie Paris
  Affiche le sélecteur de taille et les deux tableaux de mesures.
{% endcomment %}

<div class="ep-guide-tailles" style="background:{{ section.settings.bg_color }};">
  <div class="ep-guide-tailles__inner">
    {% if section.settings.heading != blank %}
      <h2 class="ep-guide-tailles__title">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.intro != blank %}
      <div class="ep-guide-tailles__intro">{{ section.settings.intro }}</div>
    {% endif %}

    {%- render 'ep-size-finder' -%}
  </div>
</div>

<style>
  .ep-guide-tailles {
    padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
  }
  .ep-guide-tailles__inner {
    max-width: 760px;
    margin: 0 auto;
  }
  .ep-guide-tailles__title {
    font-family: var(--font-heading-family, inherit);
    font-weight: 400;
    font-size: 32px;
    text-align: center;
    margin: 0 0 10px;
    color: var(--ep-ink, #50382A);
  }
  .ep-guide-tailles__intro {
    text-align: center;
    font-size: 15px;
    color: var(--ep-ink-soft, #7A6553);
    margin: 0 auto 28px;
    max-width: 560px;
  }
  .ep-guide-tailles__intro p { margin: 0 0 8px; }
</style>

{% schema %}
{
  "name": "EP Guide des tailles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Guide des tailles" },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Entrez vos mesures, nous vous indiquons la taille à commander. En cas d'hésitation, nous proposons toujours la plus grande.</p>"
    },
    { "type": "color", "id": "bg_color", "label": "Fond", "default": "#F8F5EC" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [
    { "name": "EP Guide des tailles" }
  ]
}
{% endschema %}
